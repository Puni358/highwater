VITE_DATA_SOURCE=mock          # mock | mock-dernau | api
VITE_API_BASE_URL=             # set only once endpoints are agreed
VITE_API_ZONES_PATH=
VITE_API_FLOOD_PATH=
VITE_API_ROADS_PATH=
VITE_API_FACILITIES_PATH=
VITE_API_ROUTES_PATH=
VITE_STALE_MINUTES=60

# Base map tile configuration
# Standard OpenStreetMap tile URL template (supports subdomains {s} or direct tile URL)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Optional map provider API key or token (e.g., Mapbox, Stadia, Thunderforest)
# If provided, {apiKey}, {key}, {accessToken}, or {token} tokens in the tile URL will be replaced
VITE_MAP_API_KEY=
